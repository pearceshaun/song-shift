# Apple Music credentials
APPLE_MUSIC_KEY_PATH=        # Path to .p8 private key file
APPLE_MUSIC_KEY_ID=          # Key ID from Apple Developer Portal
APPLE_MUSIC_TEAM_ID=         # Apple Developer Team ID
APPLE_MUSIC_STOREFRONT=gb    # Storefront code (e.g. gb, us)

# Optional: custom config directory
# SONG_SHIFT_CONFIG_DIR=~/.config/song-shift
